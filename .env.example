# Скопировать в .env и заполнить своими значениями. .env в git не коммитить.

# Supabase → Project Settings → Database → Connection string → URI
# (Session pooler, порт 5432; для serverless/edge — Transaction pooler, порт 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# local (бесплатно, считается на этой машине) | openai (платно, копейки)
EMBEDDING_PROVIDER=local

# Модель для локальных эмбеддингов (384-мерная, подходит под pgvector-схему по умолчанию)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Нужен только если EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Модель для generate.py (оценка вакансии + cover letter). Нужен OPENAI_API_KEY выше.
OPENAI_CHAT_MODEL=gpt-4o-mini

# Обычно трогать не нужно — подставляется автоматически по EMBEDDING_PROVIDER
# EMBEDDING_DIM=384

CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# telegram_report.py — отчёт (список вакансий + score + пояснение) в Telegram.
# Токен бота — от @BotFather. Chat id узнать так: написать боту /start, потом
# открыть https://api.telegram.org/bot<TOKEN>/getUpdates и взять message.chat.id.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
